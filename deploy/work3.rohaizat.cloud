# /etc/nginx/sites-available/work3.rohaizat.cloud
# SmartPark (NestJS + React) - KopiCode hackathon. Node app on 127.0.0.1:3600 (systemd: smartpark3.service).
# Separate from the earlier FastAPI SmartPark on work1/work2 (smartpark.service, port 8000).
# The SSL lines are added by `certbot --nginx -d work3.rohaizat.cloud`.
server {
    server_name work3.rohaizat.cloud;

    listen 80;
    listen [::]:80;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:3600;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
